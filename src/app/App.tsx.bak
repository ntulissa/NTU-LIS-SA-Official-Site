function ResourceRow({ title, sub, img, href }: { title: string; sub: string; img: string | null; href: string }) {
  return (
    <a
      href={href}
      className="flex items-center justify-between gap-4 border border-white/10 rounded-xl p-4 hover:border-white/25 hover:bg-white/3 transition-all duration-200 group"
    >
      <div className="flex items-center gap-4 min-w-0">
